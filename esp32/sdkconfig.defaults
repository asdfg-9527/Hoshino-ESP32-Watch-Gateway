# ============================================================
# WROOM low-memory config: Classic BT (BR/EDR Only) + WiFi Minimum
# Target: ESP32-WROOM with Bluetooth SPP + WiFi STA + network bridge
# ============================================================

# ---------- Bluetooth: Classic BR/EDR only; BLE disabled ----------
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
# One ACL connection (ESP32 <-> watch), saving about 1.2KB DRAM
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2
CONFIG_BT_ACL_CONNECTIONS=4
# Bind one watch only
CONFIG_BT_SMP_MAX_BONDS=4

# ---------- WiFi: Minimum memory profile (no high throughput) ----------
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP32_WIFI_RX_BA_WIN=3
CONFIG_ESP32_WIFI_TX_BA_WIN=3
CONFIG_ESP32_WIFI_MGMT_SBUF_NUM=8

# ---------- lwIP: enable IP forwarding + NAPT ----------
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_L2_TO_L3_COPY=y

# ---------- lwIP: reduced TCP buffers ----------
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=8192
CONFIG_LWIP_TCP_WND_DEFAULT=8192
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_LWIP_MAX_ACTIVE_TCP=4
CONFIG_LWIP_MAX_LISTENING_TCP=4
CONFIG_LWIP_MAX_UDP_PCBS=8
CONFIG_LWIP_MAX_RAW_PCBS=4

# ---------- Task stacks ----------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ARDUINO_LOOP_TASK_STACK_SIZE=4096
CONFIG_AUTOSTART_ARDUINO=y

# ---------- mbedTLS: enable PSK (required by WiFiClientSecure) ----------
CONFIG_MBEDTLS_PSK_MODES=y

# ---------- Flash: 2MB (actual board capacity) ----------
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y

# Arduino component requirement
CONFIG_FREERTOS_HZ=1000
